---
/**
 * Page de vente de la formation (audit de conversion, B2 et B6 ; structure du § 6). Chiffres tirés du
 * produit uniquement ; exemples chiffrés cités comme exemples (module 2.6 et examen final). Aucun
 * avis, aucune garantie, aucune urgence inventés : auteur, avis et conditions viennent de
 * src/lib/entreprise.ts et ne s'affichent que renseignés.
 */
import Avertissement from '../components/Avertissement.astro';
import FilAriane from '../components/FilAriane.astro';
import InscriptionEmail from '../components/InscriptionEmail.astro';
import Tarifs from '../components/Tarifs.astro';
import Base from '../layouts/Base.astro';
import { coursJsonLd } from '../lib/cours-jsonld';
import {
  estPublie,
  formation,
  miseAJour,
  modulesDuNiveau,
  niveaux,
  organisation,
  sectionsExercices,
  termes,
  titreSite,
  tousLesModules,
} from '../lib/donnees';
import { COURS_PUBLIC } from '../lib/edition';
import { AUTEUR, AVIS, CONDITIONS } from '../lib/entreprise';
import { checklists, lettres, toutesLesQuestions } from '../lib/parse-formation';
import { CHEMIN_VENTE, cheminModule, lien, lienElement } from '../lib/navigation';
import { SITE_PAR_DEFAUT, offreNiveau, offrePack, prixSepares, prixTexte } from '../lib/seo';
import { SIMULATEURS } from '../lib/simulateurs';

const nbQuestions = toutesLesQuestions(formation).length;
const nbExercices = sectionsExercices.filter((x) => x.portee === 'module').reduce((t, x) => t + x.exercices.length, 0);
const nbLettres = lettres(formation).length;
const nbChecklists = checklists(formation).length;
const publicNiveau = (n: number) => organisation[`Niveau ${n}`]?.public ?? '';
const dureeNiveau = (n: number) => organisation[`Niveau ${n}`]?.duree ?? '';
const filAriane = [{ libelle: 'Accueil', href: lien() }, { libelle: 'La formation' }];
const donnees = coursJsonLd(Astro.site ?? SITE_PAR_DEFAUT, lien(CHEMIN_VENTE));

// Conditions de l'offre : seules celles renseignées sont affichées.
const conditions = [
  ['Questions', CONDITIONS.accompagnement],
  ['Accès', CONDITIONS.acces],
  ['Mises à jour', CONDITIONS.misesAJour],
  ['Facture', CONDITIONS.facture],
  ['Paiement', CONDITIONS.paiement],
  ['Garantie', CONDITIONS.garantie],
].filter(([, v]) => v?.trim()) as [string, string][];

const remboursement = CONDITIONS.garantie
  ? `${CONDITIONS.garantie}. Le détail figure dans les conditions générales de vente.`
  : 'Vous disposez du droit de rétractation de quatorze jours, sauf si vous demandez l’accès immédiat au contenu et renoncez expressément à ce droit avant le paiement (article L. 221-28 du Code de la consommation). Le détail figure dans les conditions générales de vente.';

// Promesse et argumentaire : offre/promesse.md, offre/pourquoi-payer.md, offre/bonus.md.
const PROMESSE = 'Gardez votre logement louable et votre location en règle, du DPE à la déclaration';
const nbExercicesTotal = nbExercices;
const COMPARATIF: [string, string, string][] = [
  [
    'Temps passé',
    'Recherches répétées, texte par texte',
    `${tousLesModules.length} modules dans l'ordre où un bailleur en a besoin`,
  ],
  [
    'Sources à croiser',
    'Lois, décrets, BOFiP, sites publics à rapprocher soi-même',
    'Textes de référence cités à la fin de chaque module',
  ],
  [
    'Risque d’erreur',
    'Règle ancienne ou d’un autre cas, lue sur un forum',
    `${miseAJour.replace('Contenu à jour', 'À jour')}, projets de loi signalés`,
  ],
  ['Calculs', 'À refaire à la main', `${SIMULATEURS.length} simulateurs testés`],
  ['Courriers', 'À chercher et adapter', `${nbLettres} modèles de lettres à compléter`],
  [
    'Vérifier qu’on a compris',
    'Aucun moyen',
    `${nbQuestions} questions de quiz, ${nbExercicesTotal} exercices corrigés, examens notés`,
  ],
  ['Changements de loi', 'À surveiller seul', 'Page « À surveiller » et journal des mises à jour'],
];
const BONUS: [string, string][] = [
  ['La boîte à calculs', `${SIMULATEURS.length} simulateurs, reliés au module qui les explique`],
  ['Le classeur de lettres', `${nbLettres} modèles : révision du loyer, charges, relance, mise en demeure, congés…`],
  ['Les checklists', `${nbChecklists} listes à cocher, de la mise en location à la sortie du locataire`],
  ['Le calendrier des échéances', 'IRL, fin de l’encadrement, coefficient DPE 2027, logements F non décents en 2028'],
  ['L’entraînement noté', `${nbExercicesTotal} exercices, examens notés et test final de 50 questions avec bilan`],
  ['Vos questions par e-mail', 'réponse sous 72 heures ouvrées'],
];

const faq: [string, string][] = [
  [
    'Tout est gratuit ailleurs, pourquoi payer ?',
    `Les règles sont publiques mais dispersées. La formation les ordonne en trois niveaux, les illustre par des cas chiffrés et fournit ${SIMULATEURS.length} outils, ${nbLettres} lettres et ${nbChecklists} checklists. Vous gagnez du temps et vous évitez les oublis.`,
  ],
  [
    'Je n’ai pas encore de bien. Est-ce trop tôt ?',
    'Non : le niveau 1 s’adresse aux débutants complets et couvre le choix du type de location, la décence, les diagnostics, le bail et les premiers calculs de rentabilité.',
  ],
  [
    'La loi change tout le temps. La formation sera-t-elle dépassée ?',
    `Le contenu est daté (${miseAJour.toLowerCase()}) et les textes en cours d’adoption sont signalés.${CONDITIONS.misesAJour ? ` Mises à jour après l’achat : ${CONDITIONS.misesAJour}.` : ''}`,
  ],
  [
    'C’est trop technique pour moi ?',
    `Chaque niveau part des bases ; ${termes.length} termes sont expliqués dans le glossaire et chaque module se termine par un quiz et dix exercices corrigés.`,
  ],
  [
    'Combien de temps faut-il ?',
    `Niveau 1 : ${dureeNiveau(1)} ; niveau 2 : ${dureeNiveau(2)} ; niveau 3 : ${dureeNiveau(3)} (durées indicatives de la formation).`,
  ],
  [
    'Est-ce accessible sur mobile ?',
    'Oui : le site est conçu et testé pour les petits écrans, y compris les simulateurs et les lettres.',
  ],
  ['Puis-je être remboursé ?', remboursement],
  ['Puis-je poser des questions ?', `${CONDITIONS.accompagnement}.`],
  [
    'Les mises à jour sont-elles incluses ?',
    `La formation est mise à jour à chaque loi de finances et à chaque changement majeur du droit du logement ; chaque modification est datée dans le journal des mises à jour.${CONDITIONS.misesAJour ? ` Inclusion dans le prix : ${CONDITIONS.misesAJour}.` : ''}`,
  ],
  [
    'Mon logement est classé F ou G : la formation m’aide-t-elle ?',
    'Oui : les modules 1.4, 1.5 et 3.9 expliquent le calendrier de décence, le gel des loyers, la validité du DPE, les travaux et les aides ; l’outil gratuit « Mon logement est-il encore louable ? » vous situe tout de suite.',
  ],
  ...(CONDITIONS.facture ? [['Aurai-je une facture ?', CONDITIONS.facture] as [string, string]] : []),
  [
    'Est-ce un conseil personnalisé ?',
    'Non. C’est une formation d’information générale ; pour une décision engageante, consultez un avocat, un notaire, un expert-comptable ou un conseiller en gestion de patrimoine.',
  ],
  [
    'Par quel niveau commencer ?',
    niveaux.map((n) => `${publicNiveau(n.niveau)} : niveau ${n.niveau}`).join('. ') + '.',
  ],
  [
    'Les simulateurs sont-ils inclus ?',
    `Les ${SIMULATEURS.length} simulateurs et les ${nbLettres} modèles de lettres sont gratuits pour tous, sans inscription.`,
  ],
  [
    'Qui êtes-vous ?',
    `${AUTEUR.nom ? `${AUTEUR.nom}. ${AUTEUR.presentation} ` : ''}La page « Méthode et sources » explique qui écrit la formation, comment elle est construite et vérifiée, et quelles sources officielles elle utilise.`.trim(),
  ],
  ['Y a-t-il des vidéos ?', 'Non : la formation est écrite, avec tableaux, cas chiffrés, quiz et outils interactifs.'],
  ['La formation est-elle certifiante ou éligible au CPF ?', 'Non.'],
  ...(CONDITIONS.paiement ? [['Comment payer ?', CONDITIONS.paiement] as [string, string]] : []),
  [
    'Mes données sont-elles collectées ?',
    'Aucun cookie ni traceur publicitaire ; votre progression et vos saisies restent dans votre navigateur. Voir la politique de confidentialité.',
  ],
];
---

<Base
  filAriane={filAriane}
  titre="Formation investissement locatif : programme, prix et extrait gratuit"
  description={`Formation en ligne en trois niveaux : ${tousLesModules.length} modules, ${SIMULATEURS.length} simulateurs, ${nbLettres} lettres. Module 1.1 gratuit, dès ${offreNiveau(1).prix} € le niveau. À jour au 24 septembre 2026.`}
  niveau="0"
  actif="formation"
  donneesStructurees={donnees}
>
  <div class="bandeau" data-suivi-vue="vue_page_vente">
    <div class="conteneur">
      <FilAriane etapes={filAriane} />
      <p class="bandeau__sur">Formation en ligne « {titreSite} »</p>
      <h1>{PROMESSE}</h1>
      <p class="chapeau">
        Les règles de la location en France, dans l'ordre où un bailleur en a besoin : décence énergétique, loyer, bail,
        charges, impayés, fiscalité. {tousLesModules.length} modules, {SIMULATEURS.length} simulateurs, {nbLettres}{' '}
        modèles de lettres. {miseAJour}.
      </p>
      <p class="bandeau__pour-qui">
        Pour les bailleurs en place (DPE, loyer, bail, impôts), ceux qui gèrent seuls, et les futurs investisseurs : le
        niveau 1 part de zéro.
      </p>
      <p class="bandeau__actions">
        <a
          class="bouton bouton--plein"
          href={lien('module/1-1/')}
          data-suivi="clic_cta_principal debut_contenu_gratuit"
        >
          Commencer gratuitement le niveau 1
        </a>
        <a class="bouton" href="#offre" data-suivi="clic_programme_prix">
          Voir le programme et les prix
        </a>
      </p>
      <p class="bandeau__meta">
        <span>Dès {prixTexte(offreNiveau(1).prix)} le niveau</span>
        <span>{prixTexte(offrePack().prix)} les trois niveaux</span>
      </p>
    </div>
  </div>

  <div class="conteneur prose">
    <section aria-labelledby="probleme">
      <h2 id="probleme">Votre logement sera-t-il encore louable en 2028 ?</h2>
      <p>En métropole, la décence énergétique se durcit par étapes :</p>
      <ul>
        <li>
          depuis le 1er janvier 2025, un logement classé <strong>G</strong> ne peut plus faire l'objet d'un nouveau
          bail, d'un renouvellement ni d'une reconduction ;
        </li>
        <li>
          le <strong>1er janvier 2028</strong>, ce sera le tour des logements classés <strong>F</strong>, puis des
          logements <strong>E</strong> le 1er janvier 2034 ;
        </li>
        <li>
          et dès aujourd'hui, le loyer d'un logement F ou G ne peut plus être révisé, augmenté à la relocation ni
          réévalué.
        </li>
      </ul>
      <p>
        S'y ajoutent les autres erreurs de bailleur qui se paient en loyers perdus, en procédures ou en impôt : un dépôt
        de garantie rendu en retard, un congé mal délivré, un impayé mal géré, un régime fiscal mal choisi.
      </p>
      <ul>
        <li>
          Dans l'exemple du {COURS_PUBLIC ? <a href={lien(cheminModule('2.6'))}>module 2.6</a> : 'module 2.6'}, le
          régime réel plutôt que le micro-foncier représente environ 2 000 € d'impôt par an.
        </li>
        <li>
          Dans le cas de revente de l'{COURS_PUBLIC ? <a href={lien('examen/final/')}>examen final</a> : 'examen final'}
          , la réintégration des amortissements LMNP (location meublée non professionnelle) ajoute environ 11 800 €
          d'impôt.
        </li>
      </ul>
      <p>
        <em>
          Exemples pédagogiques tirés de la formation, pas des gains garantis : votre situation peut être différente.
        </em>
      </p>
    </section>

    <section aria-labelledby="methode">
      <h2 id="methode">Comment fonctionne la formation</h2>
      <ul>
        <li>
          <strong>Trois niveaux progressifs</strong>, du premier bail à la transmission.
        </li>
        <li>
          <strong>
            {nbQuestions} questions de quiz et {nbExercices} exercices corrigés
          </strong>{' '}
          (calculs, cas, vrai ou faux) pour valider chaque module, un examen noté par niveau et un test final de 50
          questions tirées au hasard.
        </li>
        <li>
          <strong>{SIMULATEURS.length} simulateurs</strong>, <strong>{nbLettres} modèles de lettres</strong> et{' '}
          <strong>{nbChecklists} checklists</strong>.
        </li>
        <li>
          <strong>Une date de mise à jour affichée</strong> et les textes en cours d'adoption signalés.
        </li>
      </ul>
    </section>

    <section aria-labelledby="gratuit">
      <h2 id="gratuit">Tout est sur service-public.fr ? Presque.</h2>
      <p>
        Les sources officielles sont excellentes et restent la référence : chaque module les cite. La formation ne les
        remplace pas, elle les ordonne.
      </p>
      <div class="tableau" role="region" tabindex="0" aria-labelledby="comparatif-legende">
        <table>
          <caption id="comparatif-legende" class="visuellement-cache">
            Chercher seul ou suivre la formation
          </caption>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">Chercher seul</th>
              <th scope="col">Suivre la formation</th>
            </tr>
          </thead>
          <tbody>
            {COMPARATIF.map(([critere, seul, formationTexte]) => (
              <tr>
                <th scope="row">{critere}</th>
                <td>{seul}</td>
                <td>{formationTexte}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        <a href={lien('methode-et-sources/')}>Méthode et sources</a> : comment la formation est construite et vérifiée.
      </p>
    </section>

    <section aria-labelledby="programme">
      <h2 id="programme">Le programme</h2>
      {niveaux.map((n) => (
        <details>
          <summary>
            Niveau {n.niveau} — {n.titreCourt} · {modulesDuNiveau(n.niveau).length} modules · {dureeNiveau(n.niveau)} ·{' '}
            {prixTexte(offreNiveau(n.niveau).prix)}
          </summary>
          <p>Pour : {publicNiveau(n.niveau).toLowerCase()}.</p>
          <ol>
            {modulesDuNiveau(n.niveau).map((m) => (
              <li>
                {estPublie(m.numero ?? '') ? (
                  <a href={lienElement(m)}>
                    Module {m.numero} — {m.titreCourt}
                  </a>
                ) : (
                  <>
                    Module {m.numero} — {m.titreCourt}
                  </>
                )}
                {m.numero === '1.1' && <strong> (gratuit)</strong>}
              </li>
            ))}
          </ol>
        </details>
      ))}
    </section>

    <section aria-labelledby="essayer">
      <h2 id="essayer">Essayez avant d'acheter</h2>
      <ul>
        <li>
          <a href={lien('commencer/')}>Le parcours « Commencer ici »</a> : une heure pour un premier résultat chiffré
          sur votre logement
        </li>
        <li>
          <a href={lien('module/1-1/')} data-suivi="debut_contenu_gratuit">
            Le module 1.1 en entier
          </a>
          , avec son quiz
        </li>
        <li>
          <a href={lien('checklist/mettre-en-location-son-premier-logement/')}>
            La checklist « Mettre en location son premier logement »
          </a>
        </li>
        <li>
          <a href={lien('simulateurs/')}>Les {SIMULATEURS.length} simulateurs</a> et{' '}
          <a href={lien('lettres/')}>les {nbLettres} modèles de lettres</a>, gratuits et sans inscription
        </li>
      </ul>
    </section>

    <section aria-labelledby="pour-qui">
      <h2 id="pour-qui">Pour qui ?</h2>
      <ul>
        <li>
          <strong>Le bailleur en place, inquiet pour son DPE</strong> : un ou deux logements, souvent anciens, classés
          E, F ou G ; il veut savoir ce qui s'applique à lui, et quand.
        </li>
        <li>
          <strong>Le bailleur qui gère seul</strong> : il rédige ses baux, révise son loyer, régularise ses charges, et
          veut éviter l'erreur coûteuse.
        </li>
        <li>
          <strong>Le futur premier investisseur</strong> : il prépare un achat et veut comparer rentabilité, fiscalité
          et contraintes avant de signer (niveau 1 : débutant complet).
        </li>
      </ul>
      <p>
        <strong>Ce n'est pas pour vous</strong> si vous cherchez un conseil personnalisé sur votre situation, une
        méthode pour vous enrichir rapidement, du droit immobilier étranger, ou des vidéos.
      </p>
    </section>

    <section aria-labelledby="auteur">
      <h2 id="auteur">{AUTEUR.nom ? 'L’auteur et la méthode' : 'La méthode'}</h2>
      {AUTEUR.nom && (
        <p>
          <strong>{AUTEUR.nom}</strong>
          {AUTEUR.presentation && ` — ${AUTEUR.presentation}`}
        </p>
      )}
      <p>
        Textes officiels cités dans chaque module, date de mise à jour affichée, textes en cours d'adoption signalés,
        exemples chiffrés présentés comme des exemples et non comme des promesses.{' '}
        <a href={lien('methode-et-sources/')}>Méthode et sources</a> ·{' '}
        <a href={lien('mises-a-jour/')}>journal des mises à jour</a>.
      </p>
    </section>

    {AVIS.length > 0 && (
      <section aria-labelledby="avis">
        <h2 id="avis">Ce qu'en disent les élèves</h2>
        {AVIS.map((a) => (
          <blockquote>
            <p>{a.texte}</p>
            <footer>
              {a.auteur} — <small>{a.verification}</small>
            </footer>
          </blockquote>
        ))}
      </section>
    )}
  </div>

  <div class="conteneur" id="offre">
    <section aria-labelledby="offre-titre">
      <h2 id="offre-titre">Choisissez votre niveau</h2>
      <p>
        Chaque niveau s'achète séparément. La formation complète réunit les trois pour {prixTexte(offrePack().prix)} au
        lieu de {prixTexte(prixSepares())}. Inclus dans chaque niveau : les modules du niveau, leurs quiz, l'examen du
        niveau, les exercices corrigés et les checklists associées. Les simulateurs et les modèles de lettres restent
        gratuits pour tous.
        {CONDITIONS.mentionPrix && ` ${CONDITIONS.mentionPrix}.`}
      </p>
      {conditions.length > 0 && (
        <ul class="offre-conditions">
          {conditions.map(([k, v]) => (
            <li>
              <strong>{k}</strong> : {v}
            </li>
          ))}
        </ul>
      )}
      <h3>Ce qui vous aide en plus</h3>
      <ul class="offre-conditions">
        {BONUS.map(([nom, contenu]) => (
          <li>
            <strong>{nom}</strong> : {contenu}
          </li>
        ))}
      </ul>
      <Tarifs />
    </section>
  </div>

  <div class="conteneur prose">
    <InscriptionEmail />
    <section aria-labelledby="faq">
      <h2 id="faq">Questions fréquentes</h2>
      {faq.map(([q, r]) => (
        <details class="faq">
          <summary>{q}</summary>
          <p>{r}</p>
        </details>
      ))}
      <p>
        Voir aussi les <a href={lien('cgv/')}>conditions générales de vente</a> et la{' '}
        <a href={lien('confidentialite/')}>politique de confidentialité</a>.
      </p>
    </section>
    <p class="vente-fin">
      <a class="bouton bouton--plein" href={lien('module/1-1/')} data-suivi="clic_cta_principal debut_contenu_gratuit">
        Commencer gratuitement le niveau 1
      </a>
    </p>
    <Avertissement />
  </div>
</Base>

<style>
  .vente-fin {
    margin: 2rem 0;
  }
  details {
    border-bottom: 1px solid var(--filet);
    padding: 0.6rem 0;
  }
  summary {
    cursor: pointer;
    font-family: var(--titre);
    font-weight: 600;
  }
  .offre-conditions {
    padding-left: 1.2rem;
  }
</style>
