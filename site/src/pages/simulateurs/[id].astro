---
import Avertissement from '../../components/Avertissement.astro';
import EncartFormation from '../../components/EncartFormation.astro';
import InscriptionEmail from '../../components/InscriptionEmail.astro';
import FilAriane from '../../components/FilAriane.astro';
import Simulateur from '../../components/Simulateur.astro';
import Base from '../../layouts/Base.astro';
import { COURS_PUBLIC } from '../../lib/edition';
import { formuleSimulateur, irlPublies, moduleParNumero } from '../../lib/donnees';
import { CHEMIN_VENTE, cheminModule, lien } from '../../lib/navigation';
import { referencementSimulateur, siglesAExpliquer, simulateurJsonLd } from '../../lib/referencement-simulateurs';
import { SITE_PAR_DEFAUT } from '../../lib/seo';
import { SIMULATEURS, type Simulateur as TSimulateur } from '../../lib/simulateurs';

export function getStaticPaths() {
  return SIMULATEURS.map((s) => ({ params: { id: s.id }, props: { simulateur: s } }));
}
interface Props {
  simulateur: TSimulateur;
}
const { simulateur: sim } = Astro.props;
const suggestions: Record<string, typeof irlPublies> = ['revision-loyer', 'loyer-relocation'].includes(sim.id)
  ? { irlAncien: irlPublies, irlNouveau: irlPublies }
  : {};
const i = SIMULATEURS.indexOf(sim);
const precedent = SIMULATEURS[i - 1];
const suivant = SIMULATEURS[i + 1];
const seo = referencementSimulateur(sim);
const formule = sim.formule ? formuleSimulateur(sim.formule) : undefined;
const niveauxDuSimulateur = [...new Set(sim.modules.map((n) => n.split('.')[0]))].sort();
const autres = SIMULATEURS.filter((s) => s !== sim);
const donnees = simulateurJsonLd(sim, Astro.url.pathname, Astro.site ?? SITE_PAR_DEFAUT);
const sigles = siglesAExpliquer(`${seo.h1} ${sim.resume}`);
// Outils dont le résultat conclut (« non décent », « non conforme ») : rappel court près du résultat.
const resultatQuiConclut = ['dpe-location', 'encadrement-loyers'].includes(sim.id);
const filAriane = [
  { libelle: 'Accueil', href: lien() },
  { libelle: 'Simulateurs', href: lien('simulateurs/') },
  { libelle: sim.titre },
];
---

<Base
  filAriane={filAriane}
  titre={seo.titre}
  description={seo.description}
  donneesStructurees={donnees}
  niveau="annexes"
  actif="simulateurs"
>
  <div data-pagefind-body>
    <div class="bandeau">
      <div class="conteneur">
        <FilAriane etapes={filAriane} />
        <p class="bandeau__sur">
          {sim.formule ? `Simulateur gratuit · formule ${sim.formule.toUpperCase()} de l'annexe E` : 'Outil gratuit'}
        </p>
        <h1>{seo.h1}</h1>
        <p>{sim.resume}</p>
        {sigles.length > 0 && (
          <p class="bandeau__sigles">
            {sigles.map(([sigle, sens], k) => (
              <>
                {k > 0 && ' · '}
                <abbr title={sens}>{sigle}</abbr> : {sens}
              </>
            ))}
          </p>
        )}
        <p class="bandeau__meta" data-pagefind-ignore>
          {COURS_PUBLIC ? (
            <>
              <span>
                Comprendre le calcul :{' '}
                {sim.modules.map((n, k) => (
                  <>
                    {k > 0 && ', '}
                    <a href={lien(cheminModule(n))}>
                      module {n}
                      {moduleParNumero(n) ? ` — ${moduleParNumero(n)?.titreCourt}` : ''}
                    </a>
                  </>
                ))}
              </span>
              {sim.formule && (
                <span>
                  <a href={lien(`annexe/e/#${sim.formule}`)}>Formule {sim.formule.toUpperCase()}</a>
                </span>
              )}
            </>
          ) : (
            <span>
              Expliqué pas à pas dans {niveauxDuSimulateur.length > 1 ? 'les niveaux' : 'le niveau'}{' '}
              {niveauxDuSimulateur.join(' et ')} de la formation :{' '}
              <a href={lien(CHEMIN_VENTE)} data-suivi="clic_encart_formation">
                découvrir la formation
              </a>
            </span>
          )}
        </p>
      </div>
    </div>
    <div class="conteneur">
      <p class="champ__aide" data-pagefind-ignore>
        {sim.exempleIllustratif
          ? "Les valeurs proposées sont un exemple : remplacez-les par les vôtres. Les résultats se mettent à jour et l'adresse de la page garde vos paramètres pour les partager."
          : "Les valeurs proposées reprennent un exemple de la formation. Modifiez-les : les résultats se mettent à jour et l'adresse de la page garde vos paramètres pour les partager."}
      </p>
      <Simulateur simulateur={sim} suggestions={suggestions} />
      {resultatQuiConclut && (
        <p class="champ__aide" data-pagefind-ignore>
          Résultat indicatif, établi à partir des seules informations saisies : il ne remplace pas l'avis d'un
          professionnel (ADIL, avocat, diagnostiqueur).
        </p>
      )}
      <div class="prose">
        <EncartFormation modules={sim.modules} />
        <InscriptionEmail />
        <section aria-labelledby="methode-titre">
          <h2 id="methode-titre">Comment le calcul est fait</h2>
          {formule ? (
            <>
              <p>
                Le simulateur applique la formule {sim.formule?.toUpperCase()} (« {formule.titre} ») de l'annexe E de la
                formation :
              </p>
              <Fragment set:html={formule.html} />
            </>
          ) : (
            <>
              <p>L'outil applique les règles suivantes, tirées de la formation :</p>
              <ul>
                {sim.methode?.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </>
          )}
        </section>
        <section aria-labelledby="autres-titre" data-pagefind-ignore>
          <h2 id="autres-titre">Autres simulateurs gratuits</h2>
          <ul class="liste-colonnes">
            {autres.map((a) => (
              <li>
                <a href={lien(`simulateurs/${a.id}/`)}>{referencementSimulateur(a).h1}</a>
              </li>
            ))}
          </ul>
        </section>
        <Avertissement />
      </div>
      <nav class="precedent-suivant" aria-label="Autres simulateurs" data-pagefind-ignore>
        {precedent ? (
          <a href={lien(`simulateurs/${precedent.id}/`)} rel="prev">
            <small>Simulateur précédent</small>
            {precedent.titre}
          </a>
        ) : (
          <span />
        )}
        {suivant && (
          <a class="suivant" href={lien(`simulateurs/${suivant.id}/`)} rel="next">
            <small>Simulateur suivant</small>
            {suivant.titre}
          </a>
        )}
      </nav>
    </div>
  </div>
</Base>
