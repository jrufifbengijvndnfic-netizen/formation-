---
import FilAriane from '../../components/FilAriane.astro';
import Base from '../../layouts/Base.astro';
import { lien } from '../../lib/navigation';
import { referencementSimulateur } from '../../lib/referencement-simulateurs';
import { SIMULATEURS } from '../../lib/simulateurs';
const filAriane = [{ libelle: 'Accueil', href: lien() }, { libelle: 'Simulateurs' }];
---

<Base
  filAriane={filAriane}
  titre={`Simulateurs immobiliers gratuits : ${SIMULATEURS.length} calculateurs pour investisseurs et bailleurs`}
  description={`Rentabilité locative, prêt, capacité d'emprunt, frais de notaire, révision de loyer, LMNP, plus-value, IFI : ${SIMULATEURS.length} simulateurs gratuits, sans inscription.`}
  niveau="annexes"
  actif="simulateurs"
>
  <div class="bandeau">
    <div class="conteneur">
      <FilAriane etapes={filAriane} />
      <p class="bandeau__sur">Gratuits, sans inscription</p>
      <h1>Simulateurs immobiliers gratuits</h1>
      <p>
        Chaque simulateur reprend une formule de l'annexe E, détaille les étapes du calcul et s'ouvre sur un exemple de
        la formation. Gratuits et sans inscription ; rien n'est envoyé : les calculs se font dans votre navigateur.
      </p>
    </div>
  </div>
  <div class="conteneur" data-pagefind-body>
    <ol class="registre">
      {SIMULATEURS.map((s, i) => (
        <li class="registre__ligne">
          <span class="registre__numero">
            <span class="parcelle">{s.formule.toUpperCase()}</span>
          </span>
          <div>
            <h2 class="registre__titre">
              <a href={lien(`simulateurs/${s.id}/`)}>{referencementSimulateur(s).h1}</a>
            </h2>
            <p class="registre__resume">{s.resume}</p>
            <p class="registre__meta">
              {s.modules.length > 1 ? 'Modules' : 'Module'} {s.modules.join(', ')} · simulateur {i + 1} sur{' '}
              {SIMULATEURS.length}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>
