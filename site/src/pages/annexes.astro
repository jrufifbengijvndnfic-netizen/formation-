---
import FilAriane from '../components/FilAriane.astro';
import Base from '../layouts/Base.astro';
import { annexes, partieAnnexes, resumer } from '../lib/donnees';
import { lien, lienElement } from '../lib/navigation';
import { texteBrut } from '../lib/render';

const resumes: Record<string, string> = Object.fromEntries(
  annexes.map((a) => {
    const n = a.rubriques.length;
    const detail =
      a.numero === 'C'
        ? `${n} lettres, index et filtre instantané`
        : n > 1
          ? `${n} rubriques`
          : resumer(texteBrut(a.intro || a.markdown), 140);
    return [a.id, detail];
  }),
);
---

<Base
  titre="Annexes"
  description={`${partieAnnexes.titreCourt} : chiffres clés, calendrier, glossaire, textes, formules, lettres, checklists, sources et points à surveiller.`}
  niveau="annexes"
  actif="annexes"
>
  <div class="bandeau">
    <div class="conteneur">
      <FilAriane etapes={[{ libelle: 'Accueil', href: lien() }, { libelle: 'Annexes' }]} />
      <p class="bandeau__sur">Annexes</p>
      <h1>{partieAnnexes.titreCourt}</h1>
    </div>
  </div>
  <div class="conteneur">
    <ol class="registre">
      {annexes.map((a) => (
        <li class="registre__ligne">
          <span class="registre__numero">
            <span class="parcelle">{a.numero}</span>
          </span>
          <div>
            <h2 class="registre__titre">
              <a href={lienElement(a)}>{a.titreCourt}</a>
            </h2>
            <p class="registre__resume">{resumes[a.id]}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>
