---
import FilAriane from '../components/FilAriane.astro';
import Base from '../layouts/Base.astro';
import { lien } from '../lib/navigation';
const filAriane = [{ libelle: 'Accueil', href: lien() }, { libelle: 'Recherche' }];
---

<Base
  indexable={false}
  filAriane={filAriane}
  titre="Recherche"
  description="Recherche plein texte dans les modules, examens, annexes, glossaire et simulateurs de la formation, avec la réponse de la formation à votre question."
  niveau="0"
  actif="recherche"
>
  <div class="bandeau">
    <div class="conteneur">
      <FilAriane etapes={filAriane} />
      <h1>Recherche</h1>
      <p>
        Raccourci clavier : <kbd>/</kbd> depuis n'importe quelle page.
      </p>
    </div>
  </div>
  <div class="conteneur prose">
    <form role="search" class="filtre" data-recherche action={lien('recherche/')} method="get">
      <div class="champ" style="flex:1;min-width:14rem">
        <label for="recherche-page">Votre question ou les mots recherchés</label>
        <input type="search" id="recherche-page" name="q" autocomplete="off" aria-describedby="recherche-etat" />
      </div>
      <button type="submit" class="bouton bouton--plein">
        Rechercher
      </button>
    </form>
    <section class="reponse-recherche" aria-labelledby="reponse-recherche-titre" hidden data-reponse-recherche>
      <h2 id="reponse-recherche-titre">La réponse de la formation</h2>
      <div data-reponse-contenu></div>
    </section>
    <p id="recherche-etat" class="checklist-etat" role="status"></p>
    <ol class="resultats-recherche" data-resultats></ol>
    <noscript>
      <p>
        La recherche nécessite JavaScript. Utilisez le <a href={lien('glossaire/')}>glossaire</a> et les pages de niveau
        pour naviguer.
      </p>
    </noscript>
  </div>
</Base>

<script>
  import '../scripts/recherche';
</script>
