---
/** L'annexe C est présentée par la page Glossaire (index, filtre, renvois) : simple redirection. */
import { lien } from '../../lib/navigation';
import { adresseAbsolue } from '../../lib/seo';
// Édition complète : l'annexe C est présentée par la page Glossaire.
const cible = lien('glossaire/');
const canonique = Astro.site ? adresseAbsolue(cible, Astro.site) : cible;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Annexe C — Glossaire de A à Z</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${cible}`} />
    <link rel="canonical" href={canonique} />
  </head>
  <body>
    <p>
      L'annexe C se trouve sur la page <a href={cible}>Glossaire</a>.
    </p>
  </body>
</html>
