---
import Avertissement from '../components/Avertissement.astro';
import Base from '../layouts/Base.astro';
import {
  annexes,
  aSurveiller,
  avecPdf,
  formation,
  miseAJour,
  modulesDuNiveau,
  niveaux,
  numerosDuNiveau,
  organisation,
  sectionsExercices,
  termes,
  titreSite,
  tousLesModules,
} from '../lib/donnees';
import { CHEMIN_VENTE, lien } from '../lib/navigation';
import { lettres, toutesLesQuestions } from '../lib/parse-formation';
import { texteBrut } from '../lib/render';
import { coursJsonLd } from '../lib/cours-jsonld';
import { SITE_PAR_DEFAUT, offreNiveau, offrePack, prixSepares, prixTexte } from '../lib/seo';
import { SIMULATEURS } from '../lib/simulateurs';

const accroche = texteBrut(formation.accroche);
const nbLettres = lettres(formation).length;
// Audit de conversion, A2 et A6 : titre orienté résultat ; titre de page avec les mots recherchés.
const titrePage = 'Formation investissement locatif en ligne : louer, gérer, déclarer';
const description = `Formation en ligne en trois niveaux : ${tousLesModules.length} modules, ${SIMULATEURS.length} simulateurs, ${nbLettres} modèles de lettres. Module 1.1 gratuit. ${accroche}`;
const pourQui = niveaux
  .map((n) => `${organisation[`Niveau ${n.niveau}`]?.public.toLowerCase()} (niveau ${n.niveau})`)
  .join(', ');
const site = Astro.site ?? new URL(SITE_PAR_DEFAUT);
// Cahier des charges SEO, § 5.1 : formation (Course) avec son offre.
const donnees = coursJsonLd(site, lien('tarifs/'));
---

<Base titre={titrePage} description={description} niveau="0" donneesStructurees={donnees}>
  <div class="bandeau" data-pagefind-body>
    <div class="conteneur">
      <p class="bandeau__sur">
        Formation en ligne « {titreSite} » · édition {formation.edition}
      </p>
      <h1>Louez, gérez et déclarez votre bien sans erreur coûteuse</h1>
      <p class="chapeau">
        {tousLesModules.length} modules, {SIMULATEURS.length} simulateurs et {nbLettres} modèles de lettres pour décider
        en connaissant les règles : bail, loyer, DPE, fiscalité, crédit, revente et transmission.
      </p>
      <p class="bandeau__pour-qui">Pour qui : {pourQui}.</p>
      <p class="bandeau__actions">
        <a
          class="bouton bouton--plein"
          href={lien('module/1-1/')}
          data-suivi="clic_cta_principal debut_contenu_gratuit"
        >
          Commencer gratuitement le niveau 1
        </a>
        <a class="bouton" href={lien(CHEMIN_VENTE)} data-suivi="clic_programme_prix">
          Voir le programme et les prix
        </a>
      </p>
      <p class="bandeau__meta">
        <span>Dès {prixTexte(offreNiveau(1).prix)} le niveau</span>
        <span>{prixTexte(offrePack().prix)} les trois niveaux</span>
        <span>{miseAJour}</span>
        <span>
          {toutesLesQuestions(formation).length} questions de quiz et{' '}
          {sectionsExercices.filter((x) => x.portee === 'module').reduce((t, x) => t + x.exercices.length, 0)} exercices
        </span>
      </p>
    </div>
  </div>

  <div class="conteneur">
    <section aria-labelledby="niveaux-titre">
      <h2 id="niveaux-titre">Trois niveaux progressifs</h2>
      <div class="feuilles">
        {niveaux.map((n) => {
          const org = organisation[`Niveau ${n.niveau}`];
          const nb = modulesDuNiveau(n.niveau).length;
          return (
            <article
              class="feuille"
              data-niveau={String(n.niveau)}
              data-avancement={numerosDuNiveau(n.niveau).join(',')}
            >
              <div class="feuille__tete">
                <span class="parcelle">N{n.niveau}</span>
                <h3>
                  <a href={lien(`niveau-${n.niveau}/`)}>{n.titreCourt}</a>
                </h3>
              </div>
              <div class="feuille__corps">
                <dl>
                  <dt>Public</dt>
                  <dd>{org?.public}</dd>
                  <dt>Durée</dt>
                  <dd>{org?.duree}</dd>
                  <dt>Contenu</dt>
                  <dd>{nb} modules et un examen</dd>
                  <dt>Prix</dt>
                  <dd>{prixTexte(offreNiveau(n.niveau).prix)}</dd>
                </dl>
                <div data-progression-seule>
                  <p class="registre__meta" data-avancement-texte>
                    Progression : 0 %
                  </p>
                  <div
                    class="jauge"
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="0"
                    aria-label={`Progression du niveau ${n.niveau}`}
                  >
                    <span class="jauge__remplissage" />
                  </div>
                </div>
                <p hidden data-si-termine>
                  <span class="badge-niveau">Niveau terminé</span>
                </p>
              </div>
            </article>
          );
        })}
      </div>
      <p>
        Formation complète : <strong>{prixTexte(offrePack().prix)}</strong> au lieu de {prixTexte(prixSepares())}.{' '}
        <a href={lien(`${CHEMIN_VENTE}#offre`)} data-suivi="clic_programme_prix">
          Voir le programme détaillé, les prix et les questions fréquentes
        </a>
      </p>
    </section>

    <section aria-labelledby="acces-titre">
      <h2 id="acces-titre">Accès rapides</h2>
      <ul class="acces">
        <li>
          <a href={lien('mode-d-emploi/')}>
            Mode d'emploi<small>Organisation, conventions et les 20 nouveautés 2025-2026</small>
          </a>
        </li>
        <li>
          <a href={lien('outils/')}>
            Outils gratuits
            <small>{SIMULATEURS.length} simulateurs : rentabilité, crédit, fiscalité, plus-value, DPE…</small>
          </a>
        </li>
        <li>
          <a href={lien('glossaire/')}>
            Glossaire<small>{termes.length} termes de A à Z</small>
          </a>
        </li>
        <li>
          <a href={lien('a-surveiller/')}>
            À surveiller<small>{aSurveiller.length} textes en cours d'adoption et échéances</small>
          </a>
        </li>
        <li>
          <a href={lien('lettres/')}>
            Modèles de lettres<small>Dix courriers à compléter, copier ou imprimer</small>
          </a>
        </li>
        <li>
          <a href={lien('annexes/')}>
            Annexes<small>{annexes.length} outils : chiffres clés, calendrier, textes, formules, checklists</small>
          </a>
        </li>
        <li>
          <a href={lien('progression/')}>
            Ma progression<small>Suivi, export et remise à zéro</small>
          </a>
        </li>
        {avecPdf && (
          <li>
            <a href={lien('formation-immobilier-locatif-2026.pdf')} download>
              Version PDF<small>La formation complète à imprimer</small>
            </a>
          </li>
        )}
      </ul>
    </section>

    <div class="prose">
      <Avertissement />
    </div>
  </div>
</Base>
