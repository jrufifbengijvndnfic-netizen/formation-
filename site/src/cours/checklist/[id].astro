---
import Avertissement from '../../components/Avertissement.astro';
import Checklist from '../../components/Checklist.astro';
import EncartFormation from '../../components/EncartFormation.astro';
import FilAriane from '../../components/FilAriane.astro';
import Base from '../../layouts/Base.astro';
import { formation, tousLesModules } from '../../lib/donnees';
import { CHECKLISTS_GRATUITES, COURS_PUBLIC } from '../../lib/edition';
import { CHEMIN_VENTE, lien, slugChecklist } from '../../lib/navigation';
import { checklists, tousLesElements } from '../../lib/parse-formation';
import type { Checklist as TChecklist, Element, Niveau } from '../../lib/types';

export function getStaticPaths() {
  return (
    tousLesElements(formation)
      .filter((e) => e.type === 'checklist')
      // Édition « outils » : seules les checklists gratuites sont publiées.
      .filter((e) => COURS_PUBLIC || CHECKLISTS_GRATUITES.includes(slugChecklist(e)))
      .map((e) => ({
        params: { id: slugChecklist(e) },
        props: { element: e, checklist: checklists(formation).find((c) => c.elementId === e.id) as TChecklist },
      }))
  );
}
interface Props {
  element: Element;
  checklist: TChecklist;
}
const { element, checklist } = Astro.props;
const n = element.niveau as Niveau;
const filAriane = [
  { libelle: 'Accueil', href: lien() },
  COURS_PUBLIC
    ? { libelle: `Niveau ${n}`, href: lien(`niveau-${n}/`) }
    : { libelle: 'La formation', href: lien(CHEMIN_VENTE) },
  { libelle: 'Checklist' },
];
---

<Base
  filAriane={filAriane}
  titre={element.titre}
  description={`${checklist.items.length} étapes à cocher : ${checklist.titre.toLowerCase()}. Checklist gratuite, cases enregistrées dans votre navigateur : décence, diagnostics, bail.`}
  niveau={String(n) as '1' | '2' | '3'}
  actif={`niveau-${n}`}
>
  <div data-pagefind-body>
    <div class="bandeau">
      <div class="conteneur">
        <FilAriane etapes={filAriane} />
        <p class="bandeau__sur">Niveau {n} · Checklist</p>
        <h1>{checklist.titre}</h1>
      </div>
    </div>
    <div class="conteneur">
      <div class="prose">
        <Checklist checklist={checklist} />
        {COURS_PUBLIC && (
          <p>
            <a href={lien('annexe/g/')}>Six autres checklists dans l'annexe G</a>
          </p>
        )}
        {CHECKLISTS_GRATUITES.includes(slugChecklist(element)) && (
          <EncartFormation
            modules={[]}
            titre="Cette checklist est un extrait gratuit de la formation"
            intro={`La formation « L'immobilier locatif en France » compte ${checklists(formation).length - 1} autres checklists, ${tousLesModules.length} modules avec leurs quiz et un examen par niveau.`}
            suivi="clic_fin_extrait"
          />
        )}
        <Avertissement />
      </div>
    </div>
  </div>
</Base>
