---
import { Font } from 'astro:assets';
import '../styles/global.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { MESURE_AUDIENCE } from '../lib/entreprise';
import { lien } from '../lib/navigation';
import {
  IMAGE_PARTAGE,
  MARQUE,
  VERIFICATIONS,
  adresseAbsolue,
  filArianeJsonLd,
  raccourcir,
  siteWebJsonLd,
  titreDePage,
  type EtapeFilAriane,
} from '../lib/seo';

interface Props {
  titre: string;
  description: string;
  /** Couleur de niveau de la page : 0 (mode d'emploi), 1, 2, 3 ou annexes. */
  niveau?: '0' | '1' | '2' | '3' | 'annexes' | undefined;
  actif?: string | undefined;
  /** Données structurées (JSON-LD) propres à la page. */
  donneesStructurees?: Record<string, unknown> | undefined;
  /** Fil d'Ariane de la page : repris en données structurées BreadcrumbList. */
  filAriane?: EtapeFilAriane[] | undefined;
  /** Faux pour la page 404 : ni adresse canonique ni indexation. */
  indexable?: boolean;
}
const { titre, description, niveau, actif, donneesStructurees, filAriane, indexable = true } = Astro.props;
const site = Astro.site ?? new URL('http://localhost/');
const titreComplet = titreDePage(titre);
const resume = raccourcir(description);
const canonique = adresseAbsolue(Astro.url.pathname, site);
const image = adresseAbsolue(lien(IMAGE_PARTAGE.chemin), site);
// Page d'accueil : nom du site et éditeur (affichage du nom « Formation Locatif » par Google).
const accueil = Astro.url.pathname === lien();
const jsonLd = [
  ...(accueil ? [siteWebJsonLd(site)] : []),
  ...(donneesStructurees ? [donneesStructurees] : []),
  ...(filAriane ? [filArianeJsonLd(filAriane, site)] : []),
];
// « </ » échappé : un texte ne peut pas refermer la balise script.
const enJson = (donnees: Record<string, unknown>) => JSON.stringify(donnees).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titreComplet}</title>
    <meta name="description" content={resume} />
    {indexable ? <link rel="canonical" href={canonique} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={MARQUE} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={resume} />
    {indexable && <meta property="og:url" content={canonique} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content={IMAGE_PARTAGE.type} />
    <meta property="og:image:width" content={String(IMAGE_PARTAGE.largeur)} />
    <meta property="og:image:height" content={String(IMAGE_PARTAGE.hauteur)} />
    <meta property="og:image:alt" content={`${MARQUE} — L'immobilier locatif en France`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1C2330" />
    {VERIFICATIONS.google && <meta name="google-site-verification" content={VERIFICATIONS.google} />}
    {VERIFICATIONS.bing && <meta name="msvalidate.01" content={VERIFICATIONS.bing} />}
    <link rel="icon" href={lien('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href={adresseAbsolue(lien('sitemap.xml'), site)} />
    <Font cssVariable="--police-titre" preload />
    <Font cssVariable="--police-texte" preload />
    <Font cssVariable="--police-mono" preload />
    {jsonLd.map((d) => (
      <script type="application/ld+json" set:html={enJson(d)}></script>
    ))}
    <script is:inline>
      (() => {
        const racine = document.documentElement;
        racine.classList.add('js');
        try {
          const theme = localStorage.getItem('formation-immobilier-locatif-2026:theme');
          if (theme === 'clair' || theme === 'sombre') racine.dataset.theme = theme;
          // Jauges de progression affichées seulement si un module a été lu ou un quiz fait.
          const p = JSON.parse(localStorage.getItem('formation-immobilier-locatif-2026:progression') || 'null');
          if (p && Object.keys(p.lus || {}).length + Object.keys(p.quiz || {}).length > 0) {
            racine.classList.add('a-progression');
          }
        } catch {
          /* stockage indisponible : thème du système */
        }
      })();
    </script>
    {MESURE_AUDIENCE && (
      <>
        <script is:inline>
          window.va =
            window.va ||
            function (...args) {
              (window.vaq = window.vaq || []).push(args);
            };
        </script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </>
    )}
  </head>
  <body data-niveau={niveau}>
    <a class="lien-evitement" href="#contenu">
      Aller au contenu
    </a>
    <EnTete actif={actif} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
