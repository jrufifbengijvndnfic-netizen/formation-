---
import Avertissement from '../components/Avertissement.astro';
import FilAriane from '../components/FilAriane.astro';
import Tarifs from '../components/Tarifs.astro';
import Base from '../layouts/Base.astro';
import { formation, miseAJour } from '../lib/donnees';
import { COURS_PUBLIC } from '../lib/edition';
import { CHEMIN_VENTE, lien } from '../lib/navigation';
import { lettres } from '../lib/parse-formation';
import { referencementLettre } from '../lib/referencement-lettres';
import { CATEGORIES_SIMULATEURS, referencementSimulateur } from '../lib/referencement-simulateurs';
import { MARQUE, SITE_PAR_DEFAUT, adresseAbsolue } from '../lib/seo';
import { SIMULATEURS, simulateurParId, type Simulateur } from '../lib/simulateurs';

const site = Astro.site ?? SITE_PAR_DEFAUT;
// Édition complète : la formation est l'accueil, cette vitrine est une page de second niveau.
const filAriane = COURS_PUBLIC ? [{ libelle: 'Accueil', href: lien() }, { libelle: 'Outils gratuits' }] : undefined;
const listeLettres = lettres(formation);
const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: MARQUE, url: adresseAbsolue('/', site), inLanguage: 'fr' },
    {
      '@type': 'Organization',
      name: MARQUE,
      url: adresseAbsolue('/', site),
      logo: adresseAbsolue('/favicon.svg', site),
    },
  ],
};
const categories = CATEGORIES_SIMULATEURS.map((c) => ({
  titre: c.titre,
  simulateurs: c.ids.map((id) => simulateurParId(id) as Simulateur),
}));
---

<Base
  titre="Simulateurs immobiliers gratuits et lettres types pour bailleurs"
  description={`${SIMULATEURS.length} simulateurs gratuits (rentabilité, prêt, frais de notaire, LMNP, plus-value, IFI…) et ${listeLettres.length} modèles de lettres pour bailleurs. Sans inscription.`}
  niveau="0"
  donneesStructurees={COURS_PUBLIC ? undefined : donnees}
  filAriane={filAriane}
  actif="simulateurs"
>
  <div class="bandeau">
    <div class="conteneur">
      {filAriane && <FilAriane etapes={filAriane} />}
      <p class="bandeau__sur">Gratuits, sans inscription · {miseAJour}</p>
      <h1>Simulateurs et outils gratuits pour bailleurs et investisseurs</h1>
      <p class="chapeau">
        {SIMULATEURS.length} simulateurs et {listeLettres.length} modèles de lettres pour calculer, comparer et rédiger
        juste. Rien n'est envoyé : tout se calcule dans votre navigateur.
      </p>
    </div>
  </div>

  <div class="conteneur">
    {categories.map((c, i) => (
      <section aria-labelledby={`categorie-${i}`}>
        <h2 id={`categorie-${i}`}>{c.titre}</h2>
        <ul class="acces">
          {c.simulateurs.map((s) => (
            <li>
              <a href={lien(`simulateurs/${s.id}/`)}>
                {referencementSimulateur(s).h1}
                <small>{s.resume}</small>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="lettres-titre">
      <h2 id="lettres-titre">Modèles de lettres</h2>
      <ul class="acces">
        {listeLettres.map((l) => (
          <li>
            <a href={lien(`lettres/${referencementLettre(l).slug}/`)}>
              {referencementLettre(l).h1}
              <small>À compléter en ligne, puis copier ou imprimer</small>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="formation-titre">
      <h2 id="formation-titre">Aller plus loin : la formation</h2>
      <p>
        Ces outils sont issus de la formation « {formation.titre.split(' — ').at(-1)} » : trois niveaux pour comprendre,
        acheter, louer, gérer, déclarer, optimiser et transmettre.
      </p>
      <p class="actions-formation">
        <a
          class="bouton bouton--plein"
          href={lien('module/1-1/')}
          data-suivi="clic_cta_principal debut_contenu_gratuit"
        >
          Commencer gratuitement le niveau 1
        </a>
        <a class="bouton" href={lien(CHEMIN_VENTE)} data-suivi="clic_programme_prix">
          Voir le programme et les prix
        </a>
      </p>
      <Tarifs />
    </section>

    <div class="prose">
      <Avertissement />
    </div>
  </div>
</Base>
