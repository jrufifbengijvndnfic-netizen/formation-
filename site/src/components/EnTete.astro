---
import { lien } from '../lib/navigation';
import { formation, miseAJour, tousLesModules } from '../lib/donnees';
import Logo from './Logo.astro';

interface Props {
  /** Rubrique active de la navigation. */
  actif?: string | undefined;
}
const { actif } = Astro.props;
const entrees = [
  { cle: 'niveau-1', libelle: 'Niveau 1', href: lien('niveau-1/'), couleur: 'var(--n1)' },
  { cle: 'niveau-2', libelle: 'Niveau 2', href: lien('niveau-2/'), couleur: 'var(--n2)' },
  { cle: 'niveau-3', libelle: 'Niveau 3', href: lien('niveau-3/'), couleur: 'var(--n3)' },
  { cle: 'annexes', libelle: 'Annexes', href: lien('annexes/') },
  { cle: 'simulateurs', libelle: 'Simulateurs', href: lien('simulateurs/') },
  { cle: 'glossaire', libelle: 'Glossaire', href: lien('glossaire/') },
  { cle: 'recherche', libelle: 'Recherche', href: lien('recherche/') },
];
const modules = tousLesModules.map((m) => m.numero).join(',');
---
<div class="mention-maj">
  <div class="conteneur">
    <span>{miseAJour}</span>
    <span>Formation pédagogique : elle ne remplace pas un conseil personnalisé. <a href={lien('a-propos/#avertissement')}>Avertissement</a></span>
  </div>
</div>
<header class="entete" data-pagefind-ignore>
  <div class="conteneur">
    <div class="entete__barre">
      <a class="logo" href={lien()}>
        <Logo />
        <span class="logo__texte">L'immobilier locatif en France<small>Formation, édition {formation.edition}</small></span>
      </a>
      <button type="button" class="bouton bouton--discret menu-bouton" aria-expanded="false" aria-controls="nav-principale">
        Menu
      </button>
      <nav class="nav-principale" id="nav-principale" aria-label="Navigation principale">
        <ul>
          {
            entrees.map((e) => (
              <li class={e.cle === 'recherche' ? 'nav-recherche' : undefined}>
                <a href={e.href} aria-current={actif === e.cle ? 'page' : undefined}>
                  {e.couleur && <span class="pastille" style={`--c:${e.couleur}`} aria-hidden="true" />}
                  {e.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <form class="recherche-entete" role="search" action={lien('recherche/')} method="get">
        <label class="visuellement-cache" for="recherche-rapide">Rechercher dans la formation</label>
        <input id="recherche-rapide" name="q" type="search" placeholder="Rechercher" autocomplete="off" />
        <kbd aria-hidden="true">/</kbd>
      </form>
      <button type="button" class="theme-bascule" aria-pressed="false" data-theme-bascule>
        <span class="visuellement-cache">Thème sombre</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M10 2a8 8 0 1 0 0 16V2Z" fill="currentColor"></path><circle cx="10" cy="10" r="7.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle></svg>
      </button>
    </div>
    <div class="progression-globale">
      <div class="jauge" data-jauge-globale data-modules={modules} role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Progression globale">
        <span class="jauge__remplissage"></span>
      </div>
      <a href={lien('progression/')} data-libelle-progression>Ma progression : 0 %</a>
    </div>
  </div>
</header>
