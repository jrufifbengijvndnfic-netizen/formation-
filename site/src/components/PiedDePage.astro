---
import { lien } from '../lib/navigation';
import { annexes, avecPdf, miseAJour } from '../lib/donnees';
---
<footer class="pied" data-pagefind-ignore>
  <div class="conteneur pied__grille">
    <section aria-labelledby="pied-formation">
      <h2 id="pied-formation">La formation</h2>
      <ul>
        <li><a href={lien('mode-d-emploi/')}>Mode d'emploi</a></li>
        <li><a href={lien('niveau-1/')}>Niveau 1 — Fondations</a></li>
        <li><a href={lien('niveau-2/')}>Niveau 2 — Gestion, fiscalité et financement</a></li>
        <li><a href={lien('niveau-3/')}>Niveau 3 — Expert</a></li>
        <li><a href={lien('progression/')}>Ma progression</a></li>
      </ul>
    </section>
    <section aria-labelledby="pied-outils">
      <h2 id="pied-outils">Boîte à outils</h2>
      <ul>
        <li><a href={lien('simulateurs/')}>Simulateurs</a></li>
        <li><a href={lien('glossaire/')}>Glossaire</a></li>
        <li><a href={lien('a-surveiller/')}>À surveiller</a></li>
        <li><a href={lien('annexe/f/')}>Modèles de lettres</a></li>
        <li><a href={lien('annexes/')}>Toutes les annexes ({annexes.length})</a></li>
      </ul>
    </section>
    <section aria-labelledby="pied-info">
      <h2 id="pied-info">Informations</h2>
      <p>{miseAJour}.</p>
      <ul>
        <li><a href={lien('a-propos/')}>À propos et avertissement</a></li>
        {avecPdf && <li><a href={lien('formation-immobilier-locatif-2026.pdf')} download>Version PDF imprimable</a></li>}
      </ul>
      <p>Aucun traceur, aucune donnée transmise : votre progression reste dans votre navigateur.</p>
    </section>
  </div>
</footer>
