---
import { lien } from '../lib/navigation';
import { annexes, avecPdf, miseAJour } from '../lib/donnees';
import { COURS_PUBLIC } from '../lib/edition';
import { EDITEUR, MESURE_AUDIENCE } from '../lib/entreprise';
import { CHEMIN_VENTE } from '../lib/navigation';
import { MARQUE } from '../lib/seo';

const annee = new Date().getFullYear();
---

<footer class="pied" data-pagefind-ignore>
  <div class="conteneur pied__grille">
    <section aria-labelledby="pied-formation">
      <h2 id="pied-formation">La formation</h2>
      <ul>
        {COURS_PUBLIC && (
          <>
            <li>
              <a href={lien('mode-d-emploi/')}>Mode d'emploi</a>
            </li>
            <li>
              <a href={lien('niveau-1/')}>Niveau 1 — Fondations</a>
            </li>
            <li>
              <a href={lien('niveau-2/')}>Niveau 2 — Gestion, fiscalité et financement</a>
            </li>
            <li>
              <a href={lien('niveau-3/')}>Niveau 3 — Expert</a>
            </li>
          </>
        )}
        <li>
          <a href={lien(CHEMIN_VENTE)}>Programme, prix et questions fréquentes</a>
        </li>
        <li>
          <a href={lien('commencer/')}>Commencer ici : votre première heure</a>
        </li>
        <li>
          <a href={lien('module/1-1/')}>Module 1.1 gratuit</a>
        </li>
        <li>
          <a href={lien('tarifs/')}>Niveaux et tarifs</a>
        </li>
        {COURS_PUBLIC && (
          <li>
            <a href={lien('progression/')}>Ma progression</a>
          </li>
        )}
      </ul>
    </section>
    <section aria-labelledby="pied-outils">
      <h2 id="pied-outils">{COURS_PUBLIC ? 'Boîte à outils' : 'Outils gratuits'}</h2>
      <ul>
        {COURS_PUBLIC && (
          <li>
            <a href={lien('outils/')}>Tous les outils gratuits</a>
          </li>
        )}
        <li>
          <a href={lien('simulateurs/')}>Simulateurs</a>
        </li>
        <li>
          <a href={lien('lettres/')}>Modèles de lettres</a>
        </li>
        {COURS_PUBLIC && (
          <>
            <li>
              <a href={lien('glossaire/')}>Glossaire</a>
            </li>
            <li>
              <a href={lien('a-surveiller/')}>À surveiller</a>
            </li>
            <li>
              <a href={lien('annexes/')}>Toutes les annexes ({annexes.length})</a>
            </li>
          </>
        )}
      </ul>
    </section>
    <section aria-labelledby="pied-info">
      <h2 id="pied-info">Informations</h2>
      <p>{miseAJour}.</p>
      <ul>
        <li>
          <a href={lien('a-propos/')}>À propos et avertissement</a>
        </li>
        <li>
          <a href={lien('methode-et-sources/')}>Méthode et sources</a>
        </li>
        <li>
          <a href={lien('mises-a-jour/')}>Mises à jour</a>
        </li>
        <li>
          <a href={lien('mentions-legales/')}>Mentions légales</a>
        </li>
        <li>
          <a href={lien('cgv/')}>Conditions générales de vente</a>
        </li>
        <li>
          <a href={lien('confidentialite/')}>Confidentialité</a>
        </li>
        {EDITEUR.email && (
          <li>
            <a href={`mailto:${EDITEUR.email}`}>Contact</a>
          </li>
        )}
        {COURS_PUBLIC && avecPdf && (
          <li>
            <a href={lien('formation-immobilier-locatif-2026.pdf')} download>
              Version PDF imprimable
            </a>
          </li>
        )}
      </ul>
      <p>
        {MESURE_AUDIENCE
          ? 'Aucun cookie ni traceur publicitaire ; mesure d’audience anonyme et sans cookie. Vos saisies restent dans votre navigateur.'
          : 'Aucun traceur, aucune donnée transmise : vos saisies restent dans votre navigateur.'}
      </p>
      <p>
        © {annee} {EDITEUR.nom || MARQUE}
      </p>
    </section>
  </div>
</footer>
