---
import { modulesExistants } from '../lib/donnees';
import { nouveauContexte, rendreEnLigne } from '../lib/render';
import type { Checklist } from '../lib/types';

interface Props {
  checklist: Checklist;
}
const { checklist } = Astro.props;
const ctx = nouveauContexte({ modulesExistants });
---

<div class="checklist-bloc" data-checklist={checklist.id} data-total={checklist.items.length}>
  <p class="checklist-etat" data-checklist-etat aria-live="polite" data-pagefind-ignore></p>
  <ol class="checklist">
    {checklist.items.map((item, i) => (
      <li>
        <label>
          <input type="checkbox" data-index={i} />
          <span set:html={rendreEnLigne(item, ctx)} />
        </label>
      </li>
    ))}
  </ol>
  <div class="groupe-boutons no-print" data-pagefind-ignore>
    <button type="button" class="bouton bouton--discret" data-checklist-raz>
      Tout décocher
    </button>
    <button type="button" class="bouton bouton--discret" data-imprimer>
      Imprimer
    </button>
  </div>
</div>

<script>
  import '../scripts/checklist';
</script>
