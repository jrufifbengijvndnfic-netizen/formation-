---
/** Frise du calendrier réglementaire (annexe B) : passé, imminent (moins de six mois) ou futur. */
import { lireDateFr, formaterDateFr } from '../lib/dates-fr';
import { formation, modulesExistants } from '../lib/donnees';
import { nouveauContexte, rendreEnLigne } from '../lib/render';
import type { Element } from '../lib/types';
import { ajouterMois } from '../lib/dates-fr';

interface Props {
  element: Element;
}
const { element } = Astro.props;
const ctx = nouveauContexte({ modulesExistants });
const lignes = element.markdown
  .split('\n')
  .map((l) => /^\| (.+?) \| (.+?) \|$/.exec(l))
  .filter((m): m is RegExpExecArray => Boolean(m) && !/^(Date|-+)$/.test((m as RegExpExecArray)[1] as string));
const evenements = lignes.map((m) => {
  const date = m[1] as string;
  const periode = lireDateFr(date);
  if (!periode) throw new Error(`Annexe B : date non reconnue « ${date} »`);
  return { date, periode, evenement: m[2] as string };
});
const reference = formation.aJourAu;
const dans6Mois = ajouterMois(reference, 6);
const periodeDe = (debut: string, fin: string) =>
  fin < reference ? 'passe' : debut <= dans6Mois ? 'imminent' : 'futur';
const LIBELLES = { passe: 'Passé', imminent: 'Dans moins de six mois', futur: 'À venir' } as const;
---

<div class="frise-bloc" data-frise data-reference={reference}>
  <p class="legende-frise" data-frise-legende>
    Situation calculée au {formaterDateFr(reference)}, date de mise à jour du contenu.
  </p>
  <ol class="frise">
    {evenements.map((e) => {
      const p = periodeDe(e.periode.debut, e.periode.fin);
      return (
        <li class="frise__evenement" data-debut={e.periode.debut} data-fin={e.periode.fin} data-periode={p}>
          <p class="frise__date">
            <time datetime={e.periode.precision === 'jour' ? e.periode.debut : e.periode.debut.slice(0, 7)}>
              {e.date}
            </time>
            <span class="frise__etiquette" data-etiquette>
              {LIBELLES[p]}
            </span>
          </p>
          <p set:html={rendreEnLigne(e.evenement, ctx)} />
        </li>
      );
    })}
  </ol>
</div>

<script>
  import '../scripts/frise';
</script>
