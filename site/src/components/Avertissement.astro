---
import { avertissementHtml } from '../lib/donnees';
import { COURS_PUBLIC } from '../lib/edition';
import { lien } from '../lib/navigation';
---

<aside class="avertissement" aria-labelledby="avertissement-titre" data-pagefind-ignore>
  <p>
    <strong id="avertissement-titre">Avertissement (section 0.4)</strong>
  </p>
  <Fragment set:html={avertissementHtml} />
  {COURS_PUBLIC && (
    <p>
      <a href={lien('annexe/h/')}>Sources officielles (annexe H)</a>
    </p>
  )}
</aside>
